{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.1.0",
  "identifier": "cc.forge.ide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "../quicklook/build.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 14
        },
        "visible": true,
        "backgroundColor": "#0c0e10",
        "dragDropEnabled": true
      }
    ],
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Entwicklungsumgebung für den ESP32",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "forgeproj"
        ],
        "name": "Forge-Projekt",
        "description": "Forge-Projekt",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-forgeproj",
        "exportedType": {
          "identifier": "cc.forge.forgeproj",
          "conformsTo": [
            "public.data"
          ]
        }
      },
      {
        "ext": [
          "ino"
        ],
        "name": "Arduino-Sketch",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "PlugIns/ForgeQuickLook.appex": "../../quicklook/build/ForgeQuickLook.appex"
      }
    },
    "copyright": "© 2026 Maximilian Schmidt",
    "publisher": "Maximilian Schmidt",
    "homepage": "https://github.com/maximilianschmidt/forge",
    "license": "MIT",
    "licenseFile": "../../../LICENSE"
  }
}
